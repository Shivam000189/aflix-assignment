# ==============================================================================
# AFLIX CRM — Backend Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this template to '.env' in the 'backend' directory:
#    cp .env.example .env
# 2. Update the placeholder values with your environment configuration.
# 3. CRITICAL: Never commit your actual '.env' file containing real secrets to git.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection Strings (Prisma ORM)
# ------------------------------------------------------------------------------
# DATABASE_URL:
#   The application's runtime connection string.
#   For cloud databases with connection pooling (e.g., Neon pooler, Supabase PgBouncer, AWS RDS Proxy),
#   this should point to the POOLED connection endpoint.
#   Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
#   Example (Neon Pooled):
#   DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
#   Example (Local PostgreSQL):
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/aflix_crm?schema=public"

# DIRECT_URL:
#   The direct, unpooled connection string to PostgreSQL.
#   Prisma Migrate and CLI schema commands require this because connection poolers (like PgBouncer
#   in transaction mode) do not support session-level advisory locks, prepared statements, or temporary tables.
#   For Neon, remove '-pooler' from the host name or use the direct connection string provided in Neon console.
#   For local PostgreSQL, DIRECT_URL is typically identical to DATABASE_URL.
#   Example (Neon Direct):
#   DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"
#   Example (Local PostgreSQL):
DIRECT_URL="postgresql://postgres:your_password@localhost:5432/aflix_crm?schema=public"

# ------------------------------------------------------------------------------
# JWT Authentication Secret Key
# ------------------------------------------------------------------------------
# Used to sign and verify JSON Web Tokens issued upon login and registration.
# Generate a strong cryptographic secret key using Node.js:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRET_KEY="your_secure_random_jwt_secret_change_in_production"
JWT_SECRET="your_secure_random_jwt_secret_change_in_production"
JWT_EXPIRES_IN="24h"

# ------------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing) Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed client origins for browser API requests.
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
