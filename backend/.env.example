# ==============================================================================
# AFLIX CRM - Environment Configuration Example
# Copy this file to '.env' and update the values with your actual configuration.
# DO NOT COMMIT THE ACTUAL '.env' FILE CONTAINING REAL SECRETS TO VERSION CONTROL!
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection URL (used by Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example local PostgreSQL: postgresql://postgres:postgres@localhost:5432/aflix_crm?schema=public
# Example Supabase/Neon/Render cloud: postgresql://user:pass@ep-cool-db.us-east-1.aws.neon.tech/aflix_crm?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/aflix_crm?schema=public"

# JWT Authentication Secret Key
# Generate a strong cryptographic key using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRET_KEY=your_secure_random_jwt_secret_change_in_production
JWT_SECRET=your_secure_random_jwt_secret_change_in_production
JWT_EXPIRES_IN=24h

# CORS Configuration
# Set allowed client origins (comma-separated or * for development)
CORS_ORIGIN=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5000
