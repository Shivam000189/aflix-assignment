# Backend API Endpoint
VITE_API_URL=http://localhost:5000/api
BACKEND_URL=http://localhost:5000/api

# Feature Flags
# Set to 'true' to explicitly enable demo login quick-fill buttons in production evaluation builds
# In development (npm run dev), demo buttons are automatically active. In production (npm run build), they are disabled by default.
VITE_ENABLE_DEMO_LOGIN=false
